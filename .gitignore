# Виртуальные окружения Python
venv/
env/
.venv/
.env/

# Byte-компилированные файлы Python
*.pyc
*.pyo
__pycache__/

# Файлы дистрибутивов и артефакты сборки
dist/
build/
*.egg-info/
*.egg

# Кэш зависимостей
.pytest_cache/
.cache/

# Логи и отчёты тестов
*.log
logs/
reports/
html-reports/

# Скриншоты Selenium (часто создаются автоматически)
screenshots/
screenshots_*.png

# Временные файлы
*.tmp
*.temp

# IDE и редакторы кода
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ОС и системные файлы
.DS_Store
Thumbs.db
Desktop.ini

# Конфигурационные файлы (если содержат чувствительные данные)
config.env
*.env

# Артефакты Selenium WebDriver
geckodriver.log
chromedriver.log

# Результаты выполнения PyTest
.pytest_cache/
pytestdebug.log